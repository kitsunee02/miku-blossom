<?xml version="1.0" encoding="UTF-8"?>
<manifest>

  <remote name="Fiyuu" fetch="https://github.com/kitsunee02" />
  <remote name="gh" fetch="https://github.com" />

  <project name="device_xiaomi_blossom" path="device/xiaomi/blossom" remote="Fiyuu" revision="hsin" />

  <project name="Jayedkhan800/android_device_mediatek_sepolicy_vndr" path="device/mediatek/sepolicy_vndr" remote="gh" revision="lineage-22" />

  <project name="HaiKito18/vendor_xiaomi_miuicamera" path="vendor/xiaomi/miuicamera" remote="gh" revision="main" />

  <project name="proprietary_vendor_xiaomi_blossom" path="vendor/xiaomi/blossom" remote="Fiyuu" revision="lineage-22.2" />

  <project path="hardware/mediatek" name="AsTechpro20/android_hardware_mediatek" remote="gh" revision="lineage-22.2" />

  <!-- blossom is a phone product, not Android Automotive; remove the
       leftover Car services tree whose RROs depend on the pruned Car apps. -->
  <remove-project name="platform/packages/services/Car" />

  <!-- Required by blossom's pixel-libperfmgr power HAL and Lineage power namespace.
       The base manifest's remove.xml excludes this AOSP project; restore it here. -->
  <project path="hardware/google/pixel" name="platform/hardware/google/pixel" remote="aosp" />

  <!-- Restore AOSP support projects that still provide modules/namespaces
       referenced by other retained Android 15 source trees. -->
  <!-- Cuttlefish module definitions are referenced outside its device tree. -->
  <project path="device/google/cuttlefish" name="device/google/cuttlefish" remote="aosp" />
  <project path="device/google/cuttlefish_prebuilts" name="device/google/cuttlefish_prebuilts" remote="aosp" clone-depth="1" />
  <project path="device/google/cuttlefish_vmm" name="device/google/cuttlefish_vmm" remote="aosp" clone-depth="1" />

  <!-- Goldfish namespace import: keep both sides together. -->
  <project path="device/generic/goldfish" name="device/generic/goldfish" remote="aosp" />
  <project path="device/generic/goldfish-opengl" name="device/generic/goldfish-opengl" remote="aosp" />
  <project path="device/generic/trusty" name="device/generic/trusty" remote="aosp" />

  <!-- Google hardware support: graphics/common imports gchips. -->
  <project path="hardware/google/camera" name="platform/hardware/google/camera" remote="aosp" />
  <project path="hardware/google/gchips" name="platform/hardware/google/gchips" remote="aosp" />
  <project path="hardware/google/graphics/common" name="platform/hardware/google/graphics/common" remote="aosp" />

  <project name="HaiKito18/ViaBrowser" path="packages/apps/ViaBrowser" remote="gh" revision="main" />

  <project path="device/xiaomi/blossom-kernel" name="crdroidandroid/android_kernel_xiaomi_blossom" remote="gh" revision="16.0">
    <linkfile src="headers" dest="kernel/xiaomi/blossom" />
  </project>

</manifest>
